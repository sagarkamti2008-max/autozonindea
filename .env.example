# ====================================================================
# AUTOZONEINDIA - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ====================================================================

# 1. SUPABASE DATABASE & STORAGE CONFIGURATION
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. PAYMENT GATEWAY CONFIGURATION (RAZORPAY / INTEGRATION GATEWAY)
VITE_PAYMENT_PROVIDER=razorpay
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
PAYMENT_PROVIDER_KEY=rzp_test_placeholder_key_id
PAYMENT_PROVIDER_SECRET=your_payment_provider_secret_here
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# 3. WHATSAPP NOTIFICATION SYSTEM CONFIGURATION
VITE_WHATSAPP_PROVIDER=mock_whatsapp
WHATSAPP_PROVIDER=meta_whatsapp
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VITE_WHATSAPP_SUPPORT_NUMBER=+919876543210

# IMPORTANT SECURITY RULES:
# - NEVER commit actual production API keys or secret tokens to Git!
# - Service-role keys must NEVER be exposed in frontend VITE_ variables.
